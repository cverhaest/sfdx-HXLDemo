# Salesforce org — configuration locale
# Copier ce fichier en .env et renseigner vos valeurs.
# .env n'est pas commité (voir .gitignore).

# Username ou alias SF CLI de l'org cible
SF_ORG_ALIAS=<your-org-alias>

# URL d'instance de l'org (ex: https://myorg.my.salesforce.com)
SF_INSTANCE_URL=https://<your-org>.my.salesforce.com

# Consumer Key de l'External Client App configurée sur l'org
SF_CLIENT_ID=<your-consumer-key>

# Nom du serveur dans ~/Library/Application Support/Claude/claude_desktop_config.json
SF_MCP_SERVER_KEY=salesforce-hxl-cvermcp
